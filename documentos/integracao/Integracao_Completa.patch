+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+const char *cartas[RF02_TOTAL_CARTAS] = {
+    "Ana", "Carlos", "Beatriz", "Jair",
+    "Marcio", "Odete", "Claudia", "Mauricio",
+    "Ana", "Carlos", "Beatriz", "Jair",
+    "Marcio", "Odete", "Claudia", "Mauricio"
+};
+
+static JogoMemoria jogo;
+static int preparado = 0;
+
+static void concluir_tentativa(int resultado) {
+    ProcessarResultadoJogada(resultado);
+    RegistrarTentativa(ObterJogadorDaUltimaJogada(), resultado);
+    AtualizarResultado();
+}
+
+EMSCRIPTEN_KEEPALIVE
+void Embaralhar(void) {
+    static int semente_definida = 0;
+    int i;
+    int j;
+    const char *guard;
+
+    if (!semente_definida) {
+        srand((unsigned int)time(0));
+        semente_definida = 1;
+    }
+
+    for (i = RF02_TOTAL_CARTAS - 1; i > 0; i--) {
+        j = rand() % (i + 1);
+        guard = cartas[i];
+        cartas[i] = cartas[j];
+        cartas[j] = guard;
+    }
+
+    preparado = rf02_inicializar(&jogo, cartas);
+    IniciarTurnos();
+    IniciarPontuacao();
+    IniciarResultado();
+}
+
+EMSCRIPTEN_KEEPALIVE
+const char *ReturnCart(int posicao) {
+    if (!preparado || posicao < 0 || posicao >= RF02_TOTAL_CARTAS) {
+        return "";
+    }
+
+    return jogo.tabuleiro.cartas[posicao].simbolo;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int EscolherCarta(int posicao) {
+    int resultado;
+
+    if (!preparado || PartidaEncerrada()) {
+        return JOGADA_INVALIDA;
+    }
+
+    resultado = rf02_escolher_carta(&jogo, posicao);
+    if (resultado == PAR_ENCONTRADO) {
+        concluir_tentativa(resultado);
+    }
+    return resultado;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int RealizarJogada(int linha1, int coluna1, int linha2, int coluna2) {
+    int resultado;
+
+    if (!preparado || PartidaEncerrada()) {
+        return JOGADA_INVALIDA;
+    }
+
+    resultado = rf02_jogar_par(&jogo, linha1, coluna1, linha2, coluna2);
+    if (resultado == PAR_ENCONTRADO) {
+        concluir_tentativa(resultado);
+    }
+    return resultado;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int EstadoDaCarta(int posicao) {
+    if (!preparado || posicao < 0 || posicao >= RF02_TOTAL_CARTAS) {
+        return -1;
+    }
+
+    return jogo.tabuleiro.cartas[posicao].estado;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int ObterPrimeiraCarta(void) {
+    return preparado ? jogo.jogada.primeira : -1;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int ObterSegundaCarta(void) {
+    return preparado ? jogo.jogada.segunda : -1;
+}
+
+EMSCRIPTEN_KEEPALIVE
