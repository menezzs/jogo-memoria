+const RF02 = Object.freeze({
+    INVALIDA: -1,
+    PRIMEIRA: 0,
+    ACERTO: 1,
+    ERRO: 2,
+    BLOQUEADA: 3
+});
+
+let temporizadorErro = null;
+let motorPronto = false;
+
+function chamarC(nome, argumentos = []) {
+    return Module.ccall(nome, "number", argumentos.map(() => "number"), argumentos);
+}
+
+function informar(texto) {
+    document.getElementById("mensagem").textContent = texto;
+}
+
+function atualizarTabuleiro() {
+    const bloqueado = chamarC("JogadaBloqueada") === 1;
+    const encerrada = chamarC("PartidaEncerrada") === 1;
+    document.getElementById("jogadorAtual").textContent = encerrada ?
+        "Partida encerrada" : `Vez do jogador ${chamarC("ObterJogadorAtual")}`;
+    for (let jogador = 1; jogador <= 2; jogador++) {
+        document.getElementById(`pontos${jogador}`).textContent = chamarC("ObterPontos", [jogador]);
+        document.getElementById(`tentativas${jogador}`).textContent = chamarC("ObterTentativas", [jogador]);
+    }
+    document.getElementById("totalTentativas").textContent = chamarC("ObterTotalTentativas");
+    document.querySelectorAll("#tabuleiro .carta").forEach((carta, posicao) => {
+        const estado = chamarC("EstadoDaCarta", [posicao]);
+        const simbolo = estado === 0 ? "?" :
+            Module.ccall("ReturnCart", "string", ["number"], [posicao]);
+        carta.textContent = simbolo;
+        carta.disabled = encerrada || bloqueado || estado !== 0;
+        carta.classList.toggle("encontrada", estado === 2);
+        carta.classList.toggle("visivel", estado === 1);
+        carta.setAttribute("aria-label", estado === 0 ?
+            `Carta oculta na linha ${Math.floor(posicao / 4) + 1}, coluna ${posicao % 4 + 1}` :
+            `${simbolo}${estado === 2 ? ", par encontrado" : ""}`);
+    });
+}
+
+function informarResultadoFinal() {
+    const vencedor = chamarC("ObterVencedor");
+    informar(vencedor === 0 ? "Empate! Cada jogador encontrou 4 pares." :
+        `Jogador ${vencedor} venceu com ${chamarC("ObterPontos", [vencedor])} pares!`);
+}
+
+function avisarJogada(resultado, primeira, segunda) {
+    document.dispatchEvent(new CustomEvent("rf02:jogadaConcluida", {
+        detail: {
+            resultado,
+            primeira,
+            segunda,
+            jogador: chamarC("ObterJogadorDaUltimaJogada"),
+            proximoJogador: chamarC("ObterJogadorAtual")
+        }
+    }));
+}
+
+function escolherCarta(posicao) {
+    if (!motorPronto) {
+        return;
+    }
+
+    const primeira = chamarC("ObterPrimeiraCarta");
+    const resultado = chamarC("EscolherCarta", [posicao]);
+    atualizarTabuleiro();
+
+    if (resultado === RF02.PRIMEIRA) {
+        informar("Escolha a segunda carta.");
+    } else if (resultado === RF02.ACERTO) {
+        if (chamarC("PartidaEncerrada")) {
+            informarResultadoFinal();
+        } else {
+            informar("Par encontrado. Escolha outra carta.");
+        }
+        avisarJogada(resultado, primeira, posicao);
+    } else if (resultado === RF02.ERRO) {
+        informar("As cartas são diferentes. Aguarde para tentar novamente.");
+        temporizadorErro = setTimeout(() => {
+            temporizadorErro = null;
+            chamarC("OcultarErro");
+            atualizarTabuleiro();
+            informar("Cartas ocultadas. Escolha uma carta.");
+            avisarJogada(resultado, primeira, posicao);
+        }, 1200);
+    } else if (resultado === RF02.INVALIDA) {
+        informar("Selecione uma carta oculta diferente da primeira.");
+    }
+}
+
+function criarTabuleiro() {
+    if (!motorPronto) {
+        return;
+    }
+
+    if (temporizadorErro !== null) {
+        clearTimeout(temporizadorErro);
+        temporizadorErro = null;
+    }
+
+    Module.ccall("Embaralhar", null, [], []);
+    const tabuleiro = document.getElementById("tabuleiro");
+    tabuleiro.innerHTML = "";
+
+    for (let i = 0; i < 16; i++) {
+        const carta = document.createElement("button");
+        carta.type = "button";
+        carta.className = "carta";
+        carta.addEventListener("click", () => escolherCarta(i));
+        tabuleiro.appendChild(carta);
+    }
+
+    atualizarTabuleiro();
+    informar("Escolha duas cartas para procurar um par.");
+    document.dispatchEvent(new CustomEvent("rf02:reinicio"));
+}
+
+var Module = {
+    onRuntimeInitialized: () => {
+        motorPronto = true;
+        document.getElementById("btnEmbaralhar").disabled = false;
+        criarTabuleiro();
+    },
+    onAbort: () => informar("Não foi possível carregar o jogo. Confira a compilação e o servidor local.")
+};
+
+document.getElementById("btnEmbaralhar").addEventListener("click", criarTabuleiro);
