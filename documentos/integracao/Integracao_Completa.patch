@@ -0,0 +1,47 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../src/turnos.h"
+#include "../src/rf02.h"
+
+int main(void) {
+    ControleTurnos a;
+    ControleTurnos b;
+    ControleTurnos invalido = {3, 0};
+
+    rf03_inicializar(&a);
+    rf03_inicializar(&b);
+    assert(rf03_obter_jogador(&a) == 1);
+    assert(rf03_obter_ultimo_jogador(&a) == 0);
+    assert(rf03_processar_resultado(&a, PRIMEIRA_CARTA) == 1);
+    assert(rf03_processar_resultado(&a, JOGADA_INVALIDA) == 1);
+    assert(rf03_processar_resultado(&a, AGUARDANDO_LIBERACAO) == 1);
+    assert(a.ultimoJogador == 0);
+    assert(rf03_processar_resultado(&a, PAR_ENCONTRADO) == 1);
+    assert(a.ultimoJogador == 1);
+    assert(rf03_processar_resultado(&a, PAR_DIFERENTE) == 2);
+    assert(a.ultimoJogador == 1);
+    assert(rf03_processar_resultado(&a, PAR_ENCONTRADO) == 2);
+    assert(a.ultimoJogador == 2);
+    assert(rf03_processar_resultado(&a, PAR_DIFERENTE) == 1);
+    assert(a.ultimoJogador == 2);
+    assert(rf03_obter_jogador(&b) == 1);
+    assert(rf03_obter_ultimo_jogador(&b) == 0);
+    assert(rf03_processar_resultado(&a, 99) == 0);
+    assert(a.jogadorAtual == 1 && a.ultimoJogador == 2);
+    rf03_inicializar(&a);
+    assert(a.jogadorAtual == 1 && a.ultimoJogador == 0);
+    rf03_inicializar(0);
+    assert(rf03_obter_jogador(0) == 0);
+    assert(rf03_obter_ultimo_jogador(0) == 0);
+    assert(rf03_processar_resultado(0, PAR_DIFERENTE) == 0);
+    assert(rf03_processar_resultado(&invalido, PAR_DIFERENTE) == 0);
+    assert(invalido.jogadorAtual == 3);
+    IniciarTurnos();
+    assert(ObterJogadorAtual() == 1);
+    assert(ProcessarResultadoJogada(PAR_DIFERENTE) == 2);
+    assert(ObterJogadorDaUltimaJogada() == 1);
+    IniciarTurnos();
+    assert(ObterJogadorAtual() == 1 && ObterJogadorDaUltimaJogada() == 0);
+    puts("RF03: regras de turno, reinicio e validacoes aprovados.");
+    return 0;
+}
