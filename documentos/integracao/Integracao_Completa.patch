+#include "resultado.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+static ResultadoPartida partida = {0, 0, -2};
+
+void rf05_inicializar(ResultadoPartida *r) {
+    if (r) {
+        r->iniciada = 1;
+        r->encerrada = 0;
+        r->vencedor = -1;
+    }
+}
+
+int rf05_verificar(ResultadoPartida *r, const Placar *p) {
+    if (!r || !p || !r->iniciada) {
+        return -2;
+    }
+    if (!r->encerrada && p->paresEncontrados == 8) {
+        r->encerrada = 1;
+        if (p->jogadores[0].pontos > p->jogadores[1].pontos) {
+            r->vencedor = 1;
+        } else if (p->jogadores[1].pontos > p->jogadores[0].pontos) {
+            r->vencedor = 2;
+        } else {
+            r->vencedor = 0;
+        }
+    }
+    return r->vencedor;
+}
+
+void IniciarResultado(void) {
+    rf05_inicializar(&partida);
+}
+
+int AtualizarResultado(void) {
+    return rf05_verificar(&partida, ConsultarPlacar());
+}
+
+EMSCRIPTEN_KEEPALIVE
+int PartidaEncerrada(void) {
+    return partida.encerrada;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int ObterVencedor(void) {
+    return partida.vencedor;
+}
