+    assert(rf04_registrar(&p, 1, PRIMEIRA_CARTA) == 0);
+    assert(rf04_registrar(0, 1, PAR_ENCONTRADO) == 0);
+    assert(rf05_verificar(&r, &p) == -2);
+    rf05_inicializar(&r);
+    assert(rf05_verificar(&r, &p) == -1);
+    for (i = 0; i < 4; i++) {
+        assert(rf04_registrar(&p, 1, PAR_ENCONTRADO) == 1);
+        assert(rf04_registrar(&p, 2, PAR_ENCONTRADO) == 1);
+    }
+    assert(rf05_verificar(&r, &p) == 0 && r.encerrada);
+    assert(rf04_registrar(&p, 1, PAR_DIFERENTE) == 0);
+    Embaralhar();
+    assert(EscolherCarta(-1) == JOGADA_INVALIDA);
+    assert(ObterTotalTentativas() == 0);
+    for (i = 0; i < 8; i++) {
+        acertar();
+    }
+    assert(PartidaEncerrada() && ObterVencedor() == 1);
+    assert(ObterPontos(1) == 8 && ObterPontos(2) == 0);
+    assert(ObterTentativas(1) == 8 && ObterTentativas(2) == 0);
+    assert(EscolherCarta(0) == JOGADA_INVALIDA);
+    assert(ObterTotalTentativas() == 8);
+    Embaralhar();
+    assert(!PartidaEncerrada() && ObterVencedor() == -1);
+    assert(ObterPontos(1) == 0 && ObterTotalTentativas() == 0);
+    errar();
+    for (i = 0; i < 8; i++) {
+        acertar();
+    }
+    assert(ObterVencedor() == 2 && ObterPontos(2) == 8);
+    assert(ObterTentativas(1) == 1 && ObterTentativas(2) == 8);
+    assert(ObterTotalTentativas() == 9);
+    Embaralhar();
+    for (i = 0; i < 4; i++) {
+        acertar();
+    }
+    errar();
+    for (i = 0; i < 4; i++) {
+        acertar();
+    }
+    assert(PartidaEncerrada() && ObterVencedor() == 0);
+    assert(ObterPontos(1) == 4 && ObterPontos(2) == 4);
+    assert(ObterParesEncontrados() == 8 && ObterTotalTentativas() == 9);
+    puts("Partida completa: vitoria dos dois jogadores, empate, bloqueio, contagem unica e reinicio aprovados.");
+    return 0;
+}
diff --git a/tests/test_rf02.c b/tests/test_rf02.c
new file mode 100644
index 0000000..358652a
--- /dev/null
+++ b/tests/test_rf02.c
@@ -0,0 +1,145 @@
+#include <assert.h>
+#include <stdio.h>
+#include <locale.h>
+#include "../src/rf02.h"
+
+static const char *nomes[RF02_TOTAL_CARTAS] = {
+    "Ana", "Carlos", "Beatriz", "Jair",
+    "Marcio", "Odete", "Claudia", "Mauricio",
+    "Ana", "Carlos", "Beatriz", "Jair",
+    "Marcio", "Odete", "Claudia", "Mauricio"
+};
+
+static int mesmo_estado(const JogoMemoria *a, const JogoMemoria *b) {
+    int i;
+
+    for (i = 0; i < RF02_TOTAL_CARTAS; i++) {
+        if (a->tabuleiro.cartas[i].simbolo != b->tabuleiro.cartas[i].simbolo ||
+            a->tabuleiro.cartas[i].estado != b->tabuleiro.cartas[i].estado) {
+            return 0;
+        }
+    }
+
+    return a->jogada.primeira == b->jogada.primeira &&
+           a->jogada.segunda == b->jogada.segunda &&
+           a->jogada.aguardando == b->jogada.aguardando;
+}
+
+int main(void) {
+    JogoMemoria jogo;
+    JogoMemoria anterior;
+    JogoMemoria outro;
+    const char *invalidos[RF02_TOTAL_CARTAS];
+    const char *separados[RF02_TOTAL_CARTAS];
+    char ana1[] = {'A', 'n', 'a', '\0'};
+    char ana2[] = {'A', 'n', 'a', '\0'};
+    int i;
+    int pares = 0;
+
+    setlocale(LC_ALL, "Portuguese");
+    assert(rf02_inicializar(&jogo, nomes) == 1);
+    assert(jogo.jogada.primeira == -1 && jogo.jogada.segunda == -1);
+    assert(!jogo.jogada.aguardando);
+    for (i = 0; i < RF02_TOTAL_CARTAS; i++) {
+        assert(jogo.tabuleiro.cartas[i].estado == CARTA_OCULTA);
+        assert(jogo.tabuleiro.cartas[i].simbolo == nomes[i]);
+        invalidos[i] = nomes[i];
+        separados[i] = nomes[i];
+    }
+    puts("01 inicializacao e 16 cartas ocultas: OK");
+
+    anterior = jogo;
+    invalidos[9] = 0;
+    assert(!rf02_inicializar(0, nomes));
+    assert(!rf02_inicializar(&jogo, 0));
+    assert(!rf02_inicializar(&jogo, invalidos));
+    assert(mesmo_estado(&jogo, &anterior));
+    assert(rf02_escolher_carta(0, 0) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(0, 1, 1, 3, 1) == JOGADA_INVALIDA);
+    assert(!rf02_ocultar_erro(0));
+    puts("02 entradas nulas e inicializacao atomica: OK");
+
+    assert(rf02_escolher_carta(&jogo, -1) == JOGADA_INVALIDA);
+    assert(rf02_escolher_carta(&jogo, 16) == JOGADA_INVALIDA);
+    assert(mesmo_estado(&jogo, &anterior));
+    assert(rf02_jogar_par(&jogo, 0, 1, 3, 1) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 5, 3, 1) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 1, 5, 1) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 1, 3, 0) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 1, 1, 1) == JOGADA_INVALIDA);
+    assert(mesmo_estado(&jogo, &anterior));
+    puts("03 limites e mesma posicao sem alterar estado: OK");
+
+    assert(rf02_escolher_carta(&jogo, 0) == PRIMEIRA_CARTA);
+    assert(jogo.tabuleiro.cartas[0].estado == CARTA_VISIVEL);
+    anterior = jogo;
+    assert(rf02_escolher_carta(&jogo, 0) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 2, 3, 2) == JOGADA_INVALIDA);
+    assert(mesmo_estado(&jogo, &anterior));
+    assert(!rf02_ocultar_erro(&jogo));
+    assert(rf02_escolher_carta(&jogo, 8) == PAR_ENCONTRADO);
+    assert(jogo.tabuleiro.cartas[0].estado == CARTA_ENCONTRADA);
+    assert(jogo.tabuleiro.cartas[8].estado == CARTA_ENCONTRADA);
+    assert(jogo.jogada.primeira == -1 && !jogo.jogada.aguardando);
+    puts("04 primeira selecao, repeticao e acerto: OK");
+
+    anterior = jogo;
+    assert(rf02_escolher_carta(&jogo, 0) == JOGADA_INVALIDA);
+    assert(rf02_jogar_par(&jogo, 1, 2, 3, 1) == JOGADA_INVALIDA);
+    assert(mesmo_estado(&jogo, &anterior));
+    puts("05 pares ja encontrados e segunda posicao indisponivel: OK");
+
+    assert(rf02_escolher_carta(&jogo, 1) == PRIMEIRA_CARTA);
+    assert(rf02_escolher_carta(&jogo, 2) == PAR_DIFERENTE);
+    assert(jogo.jogada.aguardando);
+    assert(jogo.tabuleiro.cartas[1].estado == CARTA_VISIVEL);
+    assert(jogo.tabuleiro.cartas[2].estado == CARTA_VISIVEL);
+    anterior = jogo;
+    assert(rf02_escolher_carta(&jogo, 3) == AGUARDANDO_LIBERACAO);
+    assert(rf02_jogar_par(&jogo, 2, 1, 4, 1) == AGUARDANDO_LIBERACAO);
+    assert(mesmo_estado(&jogo, &anterior));
+    assert(rf02_ocultar_erro(&jogo));
+    assert(jogo.tabuleiro.cartas[1].estado == CARTA_OCULTA);
+    assert(jogo.tabuleiro.cartas[2].estado == CARTA_OCULTA);
+    assert(jogo.tabuleiro.cartas[0].estado == CARTA_ENCONTRADA);
+    assert(jogo.jogada.primeira == -1 && jogo.jogada.segunda == -1);
+    assert(!rf02_ocultar_erro(&jogo));
+    puts("06 erro, terceira selecao bloqueada e ocultacao: OK");
+
+    assert(rf02_jogar_par(&jogo, 1, 2, 3, 2) == PAR_ENCONTRADO);
+    assert(rf02_jogar_par(&jogo, 1, 3, 3, 4) == PAR_DIFERENTE);
+    assert(rf02_inicializar(&jogo, nomes));
+    assert(jogo.jogada.primeira == -1 && !jogo.jogada.aguardando);
+    for (i = 0; i < RF02_TOTAL_CARTAS; i++) {
+        assert(jogo.tabuleiro.cartas[i].estado == CARTA_OCULTA);
+    }
+    puts("07 coordenadas humanas de 1 a 4 e reinicio durante erro: OK");
+
+    separados[0] = ana1;
+    separados[8] = ana2;
+    assert(rf02_inicializar(&jogo, separados));
+    assert(rf02_escolher_carta(&jogo, 0) == PRIMEIRA_CARTA);
+    assert(rf02_escolher_carta(&jogo, 8) == PAR_ENCONTRADO);
+    puts("08 comparacao por conteudo com enderecos diferentes: OK");
+
+    assert(rf02_inicializar(&jogo, nomes));
+    assert(rf02_inicializar(&outro, nomes));
+    assert(rf02_escolher_carta(&jogo, 0) == PRIMEIRA_CARTA);
+    assert(outro.jogada.primeira == -1);
+    assert(outro.tabuleiro.cartas[0].estado == CARTA_OCULTA);
+    puts("09 duas instancias independentes: OK");
+
+    assert(rf02_inicializar(&jogo, nomes));
+    for (i = 0; i < 8; i++) {
+        assert(rf02_escolher_carta(&jogo, i) == PRIMEIRA_CARTA);
+        assert(rf02_escolher_carta(&jogo, i + 8) == PAR_ENCONTRADO);
+        pares++;
+    }
+    assert(pares == 8);
+    for (i = 0; i < RF02_TOTAL_CARTAS; i++) {
+        assert(jogo.tabuleiro.cartas[i].estado == CARTA_ENCONTRADA);
+        assert(rf02_escolher_carta(&jogo, i) == JOGADA_INVALIDA);
+    }
+    puts("10 todos os oito pares permanecem visiveis: OK");
+    return 0;
+}
