+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+mkdir -p docs
+emcc src/projetocertificador.c src/rf02.c src/turnos.c src/pontuacao.c src/resultado.c -std=c11 -O2 -sEXPORTED_RUNTIME_METHODS=ccall -sNO_EXIT_RUNTIME=1 --shell-file web/shell.html -o docs/projetoweb.html
+mv docs/projetoweb.html docs/index.html
+cp web/jogo.js docs/jogo.js
+: > docs/.nojekyll
+printf '%s\n' 'Compilacao concluida!'
