+#include <assert.h>
+#include <stdio.h>
+#include "../src/rf02.h"
+#include "../src/turnos.h"
+
+void Embaralhar(void);
+const char *ReturnCart(int posicao);
+int EscolherCarta(int posicao);
+int RealizarJogada(int linha1, int coluna1, int linha2, int coluna2);
+int EstadoDaCarta(int posicao);
+int OcultarErro(void);
+int JogadaBloqueada(void);
+
+static int iguais(const char *a, const char *b) {
+    while (*a && *a == *b) {
+        a++;
+        b++;
+    }
+    return *a == *b;
+}
+
+static void achar_par(int *primeira, int *segunda, int mesmo_simbolo) {
+    int i;
+    int j;
+    *primeira = -1;
+    *segunda = -1;
+    for (i = 0; i < RF02_TOTAL_CARTAS; i++) {
+        for (j = i + 1; j < RF02_TOTAL_CARTAS; j++) {
+            if (EstadoDaCarta(i) == CARTA_OCULTA &&
+                EstadoDaCarta(j) == CARTA_OCULTA &&
+                iguais(ReturnCart(i), ReturnCart(j)) == mesmo_simbolo) {
+                *primeira = i;
+                *segunda = j;
+                return;
+            }
+        }
+    }
+    assert(*primeira != -1);
+}
+
+int main(void) {
+    int a;
+    int b;
+    Embaralhar();
+    assert(ObterJogadorAtual() == 1);
+    assert(ObterJogadorDaUltimaJogada() == 0);
+    assert(EscolherCarta(-1) == JOGADA_INVALIDA);
+    assert(ObterJogadorAtual() == 1);
+    achar_par(&a, &b, 1);
+    assert(EscolherCarta(a) == PRIMEIRA_CARTA);
+    assert(EscolherCarta(a) == JOGADA_INVALIDA);
+    assert(ObterJogadorDaUltimaJogada() == 0);
+    assert(EscolherCarta(b) == PAR_ENCONTRADO);
+    assert(ObterJogadorAtual() == 1);
+    assert(ObterJogadorDaUltimaJogada() == 1);
+    assert(OcultarErro() == 0);
+    achar_par(&a, &b, 0);
+    assert(EscolherCarta(a) == PRIMEIRA_CARTA);
+    assert(EscolherCarta(b) == PAR_DIFERENTE);
+    assert(ObterJogadorAtual() == 1);
+    assert(JogadaBloqueada() == 1);
+    assert(EscolherCarta(15) == AGUARDANDO_LIBERACAO);
+    assert(OcultarErro() == 1);
+    assert(ObterJogadorAtual() == 2);
+    assert(ObterJogadorDaUltimaJogada() == 1);
+    assert(OcultarErro() == 0);
+    assert(ObterJogadorAtual() == 2);
+    achar_par(&a, &b, 0);
+    assert(EscolherCarta(a) == PRIMEIRA_CARTA);
+    assert(EscolherCarta(b) == PAR_DIFERENTE);
+    assert(ObterJogadorAtual() == 2);
+    assert(OcultarErro() == 1);
+    assert(ObterJogadorAtual() == 1);
+    assert(ObterJogadorDaUltimaJogada() == 2);
+    Embaralhar();
+    assert(ObterJogadorAtual() == 1);
+    assert(ObterJogadorDaUltimaJogada() == 0);
+    achar_par(&a, &b, 1);
+    assert(RealizarJogada(a / 4 + 1, a % 4 + 1, b / 4 + 1, b % 4 + 1) == PAR_ENCONTRADO);
+    assert(ObterJogadorAtual() == 1 && ObterJogadorDaUltimaJogada() == 1);
+    achar_par(&a, &b, 0);
+    assert(RealizarJogada(a / 4 + 1, a % 4 + 1, b / 4 + 1, b % 4 + 1) == PAR_DIFERENTE);
+    assert(ObterJogadorAtual() == 1);
+    assert(OcultarErro() == 1);
+    assert(ObterJogadorAtual() == 2 && ObterJogadorDaUltimaJogada() == 1);
+    assert(RealizarJogada(0, 1, 1, 2) == JOGADA_INVALIDA);
+    assert(ObterJogadorAtual() == 2);
+    Embaralhar();
+    assert(ObterJogadorAtual() == 1 && ObterJogadorDaUltimaJogada() == 0);
+    puts("Integracao RF02 + RF03: acerto, erro, bloqueio e reinicio aprovados.");
+    return 0;
+}
diff --git a/tests/test_interface_wasm.cjs b/tests/test_interface_wasm.cjs
new file mode 100644
index 0000000..7a7779a
--- /dev/null
+++ b/tests/test_interface_wasm.cjs
@@ -0,0 +1,130 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+class Elemento {
+    constructor() {
+        this.children = [];
+        this.listeners = {};
+        this.disabled = false;
+        this.textContent = '';
+        this.classes = new Set();
+        this.classList = {toggle: (nome, ativo) => ativo ? this.classes.add(nome) : this.classes.delete(nome)};
+    }
+    set className(valor) {this.classes = new Set(valor.split(' '));}
+    set innerHTML(valor) {if (valor === '') this.children = [];}
+    appendChild(elemento) {this.children.push(elemento);}
+    addEventListener(nome, fn) {(this.listeners[nome] ||= []).push(fn);}
+    setAttribute() {}
+    click() {if (!this.disabled) for (const fn of this.listeners.click || []) fn();}
+}
+
+async function testar() {
+    const motor = require('../docs/projetoweb.js');
+    await new Promise((resolve, reject) => {
+        motor.onRuntimeInitialized = resolve;
+        motor.onAbort = reject;
+    });
+    const elementos = Object.fromEntries(['tabuleiro', 'mensagem', 'btnEmbaralhar', 'jogadorAtual', 'pontos1', 'pontos2', 'tentativas1', 'tentativas2', 'totalTentativas'].map(nome => [nome, new Elemento()]));
+    const eventos = [];
+    const timers = new Map();
+    let timer = 0;
+    const ambiente = vm.createContext({
+        document: {
+            getElementById: nome => elementos[nome],
+            createElement: () => new Elemento(),
+            querySelectorAll: () => elementos.tabuleiro.children,
+            dispatchEvent: evento => eventos.push(evento)
+        },
+        CustomEvent: class {constructor(type, dados) {this.type = type;this.detail = dados?.detail;}},
+        setTimeout: fn => {timers.set(++timer, fn);return timer;},
+        clearTimeout: id => timers.delete(id)
+    });
+    vm.runInContext(fs.readFileSync(path.join(__dirname, '../web/jogo.js'), 'utf8'), ambiente);
+    ambiente.Module.ccall = motor.ccall;
+    const api = (nome, ...args) => motor.ccall(nome, 'number', args.map(() => 'number'), args);
+    const concluidas = () => eventos.filter(e => e.type === 'rf02:jogadaConcluida');
+    const disparar = () => {const pendentes = [...timers.values()];timers.clear();pendentes.forEach(fn => fn());};
+    const clicar = posicao => elementos.tabuleiro.children[posicao].click();
+    const verificarVez = jogador => assert.equal(elementos.jogadorAtual.textContent, `Vez do jogador ${jogador}`);
+    const nomes = () => Array.from({length: 16}, (_, i) => motor.ccall('ReturnCart', 'string', ['number'], [i]));
+    ambiente.Module.onRuntimeInitialized();
+    verificarVez(1);
+    assert.equal(elementos.tabuleiro.children.length, 16);
+    assert(elementos.tabuleiro.children.every(c => c.textContent === '?' && !c.disabled));
+    const cartas = nomes();
+    const par = cartas.findIndex((nome, i) => i > 0 && nome === cartas[0]);
+    clicar(0);
+    clicar(0);
+    assert.equal(concluidas().length, 0);
+    verificarVez(1);
+    clicar(par);
+    assert.equal(concluidas().length, 1);
+    assert.equal(concluidas()[0].detail.resultado, 1);
+    assert.equal(concluidas()[0].detail.jogador, 1);
+    assert.equal(concluidas()[0].detail.proximoJogador, 1);
+    assert.equal(api('ObterPontos', 1), 1);
+    assert.equal(api('ObterTotalTentativas'), 1);
+    verificarVez(1);
+    const a = cartas.findIndex((_, i) => i !== 0 && i !== par);
+    const b = cartas.findIndex((nome, i) => i !== 0 && i !== par && i !== a && nome !== cartas[a]);
+    clicar(a);
+    clicar(b);
+    assert(elementos.tabuleiro.children.every(c => c.disabled));
+    verificarVez(1);
+    assert.equal(concluidas().length, 1);
+    elementos.tabuleiro.children.forEach(c => c.click());
+    disparar();
+    verificarVez(2);
+    assert.equal(concluidas().length, 2);
+    assert.equal(concluidas()[1].detail.resultado, 2);
+    assert.equal(concluidas()[1].detail.jogador, 1);
+    assert.equal(concluidas()[1].detail.proximoJogador, 2);
+    assert.equal(elementos.tabuleiro.children[a].textContent, '?');
+    assert.equal(api('OcultarErro'), 0);
+    assert.equal(api('ObterJogadorAtual'), 2);
+    assert.equal(api('ObterTentativas', 1), 2);
+    assert.equal(api('ObterPontos', 2), 0);
+    const par2 = cartas.findIndex((nome, i) => i !== a && nome === cartas[a]);
+    clicar(a);
+    clicar(par2);
+    verificarVez(2);
+    assert.equal(concluidas().at(-1).detail.jogador, 2);
+    const livres = cartas.map((_, i) => i).filter(i => api('EstadoDaCarta', i) === 0);
+    const c = livres[0];
+    const d = livres.find(i => cartas[i] !== cartas[c]);
+    clicar(c);
+    clicar(d);
+    const quantidadeAntes = concluidas().length;
+    elementos.btnEmbaralhar.click();
+    disparar();
+    verificarVez(1);
+    assert.equal(api('ObterJogadorDaUltimaJogada'), 0);
+    assert.equal(api('ObterTotalTentativas'), 0);
+    assert.equal(concluidas().length, quantidadeAntes);
+    assert(elementos.tabuleiro.children.every(carta => carta.textContent === '?' && !carta.disabled));
+    const final = nomes();
+    const usados = new Set();
+    for (let i = 0; i < 16; i++) {
+        if (usados.has(i)) continue;
+        const j = final.findIndex((nome, indice) => indice !== i && !usados.has(indice) && nome === final[i]);
+        clicar(i);
+        clicar(j);
+        usados.add(i);
+        usados.add(j);
+    }
+    assert(elementos.tabuleiro.children.every(carta => carta.classes.has('encontrada')));
+    assert.equal(elementos.jogadorAtual.textContent, 'Partida encerrada');
+    assert.equal(api('ObterVencedor'), 1);
+    assert.equal(api('ObterPontos', 1), 8);
+    assert.equal(api('ObterTotalTentativas'), 8);
+    assert.match(elementos.mensagem.textContent, /Jogador 1 venceu/);
+    const tentativasFinais = api('ObterTotalTentativas');
+    elementos.tabuleiro.children.forEach(carta => carta.click());
+    assert.equal(api('ObterTotalTentativas'), tentativasFinais);
+    console.log('WebAssembly real + interface JavaScript com DOM simulado: aprovado.');
+    console.log('Vez na tela, jogador nos eventos, erro com atraso, reinicio e oito pares: aprovados.');
+}
+
+testar().catch(erro => {console.error(erro);process.exitCode = 1;});
