+#include <assert.h>
+#include <stdio.h>
+#include <locale.h>
+
+void Embaralhar(void);
+const char *ReturnCart(int posicao);
+int EscolherCarta(int posicao);
+int EstadoDaCarta(int posicao);
+int ObterPrimeiraCarta(void);
+int JogadaBloqueada(void);
+int OcultarErro(void);
+
+static int iguais(const char *a, const char *b) {
+    int i = 0;
+    while (a[i] != '\0' && a[i] == b[i]) {
+        i++;
+    }
+    return a[i] == b[i];
+}
+
+int main(void) {
+    int i;
+    int j;
+    int par = -1;
+    int ocorrencias;
+
+    setlocale(LC_ALL, "Portuguese");
+    assert(EscolherCarta(0) == -1);
+    assert(EstadoDaCarta(0) == -1);
+    assert(ReturnCart(0)[0] == '\0');
+    Embaralhar();
+    for (i = 0; i < 16; i++) {
+        ocorrencias = 0;
+        assert(EstadoDaCarta(i) == 0);
+        for (j = 0; j < 16; j++) {
+            ocorrencias += iguais(ReturnCart(i), ReturnCart(j));
+        }
+        assert(ocorrencias == 2);
+    }
+    assert(ReturnCart(-1)[0] == '\0');
+    assert(ReturnCart(16)[0] == '\0');
+    assert(EstadoDaCarta(-1) == -1);
+    for (j = 1; j < 16; j++) {
+        if (iguais(ReturnCart(0), ReturnCart(j))) {
+            par = j;
+        }
+    }
+    assert(par != -1);
+    assert(EscolherCarta(0) == 0);
+    assert(ObterPrimeiraCarta() == 0);
+    assert(EscolherCarta(par) == 1);
+    assert(EstadoDaCarta(0) == 2);
+    assert(EstadoDaCarta(par) == 2);
+    assert(!JogadaBloqueada() && !OcultarErro());
+    Embaralhar();
+    assert(ObterPrimeiraCarta() == -1);
+    for (i = 0; i < 16; i++) {
+        assert(EstadoDaCarta(i) == 0);
+    }
+    puts("11 ponte publica, embaralhamento com oito pares e reinicio: OK");
+    return 0;
+}
